{
  "name": "pirundown-designer",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "description": "Visual authoring and cue-sheet designer application for Rundown v2 YAML serving Riihimäen Keskuskirkko",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pirundown-designer": "bin/pirundown-designer.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:ui": "pnpm -C ui run dev",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "pnpm -C ui run build",
    "build": "pnpm run build:server && pnpm run build:ui",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin",
    "ui/dist"
  ],
  "pi": {
    "service": "pirundown-designer",
    "displayName": "PiRundown Designer",
    "layer": "+1 Control Plane & Staging",
    "port": 3410,
    "ports": {
      "uiDev": 5174
    },
    "healthEndpoint": "/api/v1/health",
    "envPortVar": "PORT"
  }
}
